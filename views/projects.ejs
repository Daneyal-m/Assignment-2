<%- include('partials/header') %> <%# include the shared header partial %> 

<main class="container my-5"> <%# main content wrapper %>
  <section id="Projects">
    <h2 class="mb-4">Projects</h2>

    <div class="card mb-4"> <%# Project 1 card: includes the title, image, and short intro to the project %>
      <div class="card-body">
        <h3 class="card-title mb-3">Project 1 | Cosmic Carnage!</h3>
        <img src="/images/CosmicCarnage.png" alt="Cosmic Carnage" class="img-fluid rounded mb-3">
        <p class="card-text">
          A 2D space shooter game where the player fights aliens on different planets until they reach the final boss. This was my final project for an elective programming class. I was in charge of all the art and story of the game.
        </p>
      </div>
    </div>

    <div class="card mb-4"> <%# Project 2 card: includes the title, image, and short intro to the project %>
      <div class="card-body">
        <h3 class="card-title mb-3">Project 2 | Khidmaatt</h3>
        <img src="/images/khidmaatt.png" alt="Khidmaatt" class="img-fluid rounded mb-3">
        <p class="card-text">
          A website for a local business that provides repair and maintenance services to all home appliances and electronic devices. The website includes a contact form, service list, and online booking system.
        </p>
      </div>
    </div>

    <div class="card mb-4"> <%# Project 3 card: includes the title, image, and short intro to the project %>
      <div class="card-body"> 
        <h3 class="card-title mb-3">Project 3 | Aus Adventures</h3>
        <img src="/images/AusAdventures.png" alt="Aus Adventures" class="img-fluid rounded mb-3">
        <p class="card-text">
          A website for my high school travel and tourism club. The website features photos and information about our trip throughout Dubai and an introduction to the group.
        </p>
      </div>
    </div>

    <div class="card mb-4"> <%# Project 4 card: includes the title, image, and short intro to the project %>
      <div class="card-body">
        <h3 class="card-title mb-3">Project 4 | To-Do List</h3>
        <p class="card-text">
          An interactive To-do planner that allows users to create, edit, and delete tasks. The application also lets you add time and date information to each task as well as reminder notifications.
        </p>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %> <%# include the shared footer partial %>