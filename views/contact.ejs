<%- include('partials/header') %>

<main class="container my-5">
  <section id="Contact">
    <div class="row justify-content-center">
      <div class="col-md-10 col-lg-8">
        <div class="card p-4">
          <h2 class="text-center mb-4">Contact Me</h2>

          <form action="mailto:mohammeddaneyal.mazher@ontariotechu.net" method="post" enctype="text/plain">
            <div class="mb-3">
              <label for="firstName" class="form-label fw-bold">First Name *</label>
              <input type="text" class="form-control" name="firstName" id="firstName" required minlength="2" placeholder="e.g. John">
            </div>

            <div class="mb-3">
              <label for="lastName" class="form-label fw-bold">Last Name *</label>
              <input type="text" class="form-control" name="lastName" id="lastName" required minlength="2" placeholder="e.g. Doe">
            </div>

            <div class="mb-3">
              <label for="email" class="form-label fw-bold">E-mail *</label>
              <input type="email" class="form-control" name="email" id="email" required placeholder="e.g. email@email.com">
            </div>

            <div class="mb-3">
              <label for="Comments" class="form-label fw-bold">Comments *</label>
              <textarea class="form-control" name="Comments" id="Comments" rows="4" required minlength="10" placeholder="Write your comments here..."></textarea>
            </div>

            <button type="submit" class="btn w-100 mt-2">Submit</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>